[Unit]
Description=Duet (Next.js)
After=network.target docker.service
Wants=docker.service

[Service]
Type=simple
WorkingDirectory=/root/Duet
EnvironmentFile=/root/Duet/.env.node
ExecStart=/opt/node/bin/node node_modules/next/dist/bin/next start -p 80
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
