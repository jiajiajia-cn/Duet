# 生产环境变量示例（本地开发用 .env，不要提交）
# 复制成 .env 或填到云托管的「环境变量」里

# 数据库连接串
#  — 容器内自带 PostgreSQL：postgresql://postgres@127.0.0.1:5432/checkin?schema=public
#  — 用外部数据库（Neon / Supabase）：填它们给的连接串
DATABASE_URL="postgresql://postgres@127.0.0.1:5432/checkin?schema=public"

# 登录 cookie 的签名密钥，必须换成随机值：
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# 上传图片存放目录（容器里指向挂载的持久盘）
UPLOAD_DIR="/data/uploads"

# 勾上表示在容器里顺带跑一个 PostgreSQL（数据落在 /data/pg）
LOCAL_PG="1"

# 站点地址（可选，用于 PWA / 分享链接）
NEXT_PUBLIC_APP_URL="https://你的地址"
